<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<% content_for :title, "Formulários" %>

<h1>Formulários</h1>

<div id="formularios">
  <% @formularios.each do |formulario| %>
    <%= render formulario %>
    <p>
      <%= link_to "Ver formulário", formulario %>
    </p>
  <% end %>
</div>

<%= link_to "Novo formulário", new_formulario_path %>
