<h1>CAMAAR</h1>

<%= render "shared/flash" %>

<aside aria-label="Menu lateral">
  <% if current_user.admin? %>
    <nav>
      <%= button_to "Importar participantes do SIGAA", imports_class_members_path %>
      <%= link_to "Gerenciar templates", templates_path %>
      <%= link_to "Gerenciar formularios", formularios_path %>
      <a href="#">Resultados</a>
    </nav>
  <% else %>
    <nav>
      <%= link_to "Formularios pendentes", formularios_path %>
    </nav>
  <% end %>
</aside>

<p>Usuario autenticado: <%= current_user.name %></p>
