<div id="<%= dom_id aluno %>">
  <div>
    <strong>Matricula:</strong>
    <%= aluno.matricula %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= aluno.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= aluno.email %>
  </div>

  <div>
    <strong>Password digest:</strong>
    <%= aluno.password_digest %>
  </div>

  <div>
    <strong>Course:</strong>
    <%= aluno.course %>
  </div>

</div>
