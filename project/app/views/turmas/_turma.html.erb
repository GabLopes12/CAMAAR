<div id="<%= dom_id turma %>">
  <div>
    <strong>Subject code:</strong>
    <%= turma.subject_code %>
  </div>

  <div>
    <strong>Subject name:</strong>
    <%= turma.subject_name %>
  </div>

  <div>
    <strong>Class code:</strong>
    <%= turma.class_code %>
  </div>

  <div>
    <strong>Semester:</strong>
