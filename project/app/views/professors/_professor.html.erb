<div id="<%= dom_id professor %>">
  <div>
    <strong>Matricula:</strong>
    <%= professor.matricula %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= professor.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= professor.email %>
  </div>

  <div>
    <strong>Password digest:</strong>
    <%= professor.password_digest %>
  </div>

  <div>
    <strong>Formation:</strong>
    <%= professor.formation %>
  </div>

  <div>
    <strong>Departamento:</strong>
    <%= professor.departamento_id %>
  </div>

</div>
